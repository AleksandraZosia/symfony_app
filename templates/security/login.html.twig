{% extends 'base.html.twig' %}

{% block title %}Zaloguj!{% endblock %}

{% block body %}
    <form method="post">
       

        {% if app.user %}
            <div class="mb-3">
                Zalogowany użytkownik: {{ app.user.userIdentifier }} | <a href="{{ logout_path() }}">Wyloguj</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Login</h1>
        <div><label for="username">Login</label>
        <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus></div>
        <div>
        <label for="password">Hasło</label>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
        </div>
        <div>
 {% if error %}
            <div class="alert alert-danger" role='alert'>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        <button class="btn btn-lg btn-primary" type="submit">
            Zaloguj
        </button>
        </div>
    </form>
{% endblock %}
